# 백엔드 (src)
PORT=3000
JWT_SECRET=replace-this-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=1209600

# AI 서비스 주소 (ai-service 가 뜨는 곳). 비워두면 백엔드가 로컬 폴백으로 동작.
AI_BASE_URL=http://localhost:8000

# Persistence (backend only). Supabase mode requires both values below.
PERSISTENCE_ADAPTER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side NAVER geo providers; never expose secrets to the frontend.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# Frontend browser configuration (public client identifier only)
VITE_NAVER_MAP_CLIENT_ID=
